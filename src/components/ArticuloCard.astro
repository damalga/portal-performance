---
import PlaceholderPortada from "./PlaceholderPortada.astro";

interface Props {
  titulo: string;
  etiquetaPortada: string;
  slug: string;
  resumen: string;
  categoria: "dom" | "eventos" | "datos" | "metricas";
}

const { titulo, etiquetaPortada, slug, resumen, categoria } = Astro.props;
---

<article class="tarjeta">
  <a href={`/ejercicios/${slug}`} class="enlace">
    <PlaceholderPortada titulo={etiquetaPortada} categoria={categoria} compacto />
    <div class="cuerpo">
      <h2>{titulo}</h2>
      <p>{resumen}</p>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    display: contents;
  }

  .enlace {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--texto);
    border-radius: var(--radio-md);
    overflow: hidden;
    transition: transform 120ms ease-out;
  }

  .enlace:hover {
    transform: translateY(-2px);
  }

  .cuerpo {
    padding: var(--esp-md);
    display: flex;
    flex-direction: column;
    gap: var(--esp-xs);
  }

  h2 {
    font-family: var(--fuente-display);
    font-size: var(--paso-2);
    line-height: var(--lh-corto);
    margin: 0;
  }

  p {
    font-size: var(--paso-00);
    color: var(--texto);
    margin: 0;
  }

  .meta {
    font-family: var(--fuente-mono);
    font-size: var(--paso-000);
    letter-spacing: 0.05em;
  }
</style>
