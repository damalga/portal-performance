---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<aside class="cta" aria-label="Ver este patrón integrado con los otros">
  <p>
    <span class="etiqueta">En acción</span>
    Este patrón está aplicado, funcionando, junto con los otros siete en una misma página.
  </p>
  <a href={`/en-accion#${slug}`}>Verlo en la demo integrada →</a>
</aside>

<style>
  .cta {
    margin: var(--esp-2xl) 0;
    padding: var(--esp-lg);
    border: 2px solid var(--texto);
    border-radius: var(--radio-md);
    background: var(--destacado);
    color: var(--tinta);
    display: flex;
    flex-direction: column;
    gap: var(--esp-sm);
  }

  .etiqueta {
    display: inline-block;
    font-family: var(--fuente-mono);
    font-size: var(--paso-000);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--esp-2xs) var(--esp-xs);
    background: var(--tinta);
    color: var(--destacado);
    border-radius: var(--radio-sm);
    margin-right: var(--esp-xs);
  }

  .cta p {
    margin: 0;
    font-size: var(--paso-0);
    max-width: none;
  }

  .cta a {
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: var(--paso-1);
    color: var(--tinta);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    align-self: flex-start;
  }
</style>
