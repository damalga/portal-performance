---
const rutas = [{ href: "/", texto: "Ejercicios" }];
const actual = Astro.url.pathname;
---

<header class="cabecera">
  <a href="/" class="marca">Portal Performance</a>
  <nav aria-label="Principal">
    <ul>
      {
        rutas.map(({ href, texto }) => (
          <li>
            <a href={href} aria-current={actual === href ? "page" : undefined}>
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-lg);
    padding: var(--esp-md) var(--esp-lg);
    border-bottom: 1px solid var(--texto);
    background: var(--fondo);
  }

  .marca {
    font-family: var(--fuente-display);
    font-weight: 800;
    font-size: var(--paso-1);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: inherit;
  }

  nav ul {
    display: flex;
    gap: var(--esp-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--fuente-mono);
    font-size: var(--paso-00);
    text-decoration: none;
    color: inherit;
    padding: var(--esp-2xs) var(--esp-xs);
    border-radius: var(--radio-sm);
  }

  nav a[aria-current="page"] {
    background: var(--destacado);
    color: var(--tinta);
  }

  nav a:hover:not([aria-current="page"]) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--acento);
  }
</style>
