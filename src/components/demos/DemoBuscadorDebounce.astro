---
import Nota from "../Nota.astro";
---

<section
  id="demo-buscador-debounce"
  class="demo-panel"
  aria-labelledby="demo-buscador-debounce-titulo"
>
  <header class="demo-titulo">
    <span class="demo-etiqueta">Pruébalo</span>
    <h3 id="demo-buscador-debounce-titulo">Filtrar en cada tecla vs debounce</h3>
  </header>

  <p class="demo-intro">
    Elige un modo y escribe: solo el modo activo procesa el input. Sube la lista
    a 1.000 elementos y prueba <strong>sin debounce</strong>: el propio teclear
    se engancha porque cada pulsación filtra y repinta con
    <code>innerHTML +=</code> dentro del bucle. Cambia a <strong>con debounce</strong>:
    fluido, y el contador solo sube una vez por pausa.
  </p>

  <Nota tipo="info">
    <p>
      Los dos modos comparten el mismo <code>&lt;input&gt;</code>, pero cada uno
      corre su propio handler aislado. Antes ambos se disparaban a la vez y la
      versión con debounce quedaba lastrada por la sin debounce, aunque
      técnicamente estuviese bien.
    </p>
  </Nota>

  <div class="demo-controles" role="group" aria-label="Comparativa">
    <div class="modo-selector" role="tablist" aria-label="Elegir modo">
      <button
        type="button"
        data-modo="roto"
        class="demo-boton roto"
        role="tab"
        aria-selected="false"
      >
        Sin debounce
      </button>
      <button
        type="button"
        data-modo="solucion"
        class="demo-boton solucion activo"
        role="tab"
        aria-selected="true"
      >
        Con debounce
      </button>
    </div>
    <input
      type="text"
      id="demo-buscador-debounce-input"
      class="input-buscador"
      placeholder="Escribe para filtrar..."
      autocomplete="off"
      spellcheck="false"
    />
    <label class="demo-cantidad">
      <span>Productos</span>
      <select id="demo-buscador-debounce-cantidad">
        <option value="5">5</option>
        <option value="100">100</option>
        <option value="1000" selected>1.000</option>
      </select>
    </label>
    <button type="button" data-accion="reset" class="demo-boton reset"> Reset </button>
  </div>

  <div class="panel-resultados" data-modo="solucion">
    <div class="columna roto">
      <div class="cabecera-columna">Sin debounce · innerHTML += en bucle</div>
      <div class="stats-columna" id="demo-buscador-debounce-stats-roto">
        Filtros: 0 · último: — ms
      </div>
      <div
        id="demo-buscador-debounce-lista-roto"
        class="lista-buscador"
        aria-label="Resultados sin debounce"
      >
      </div>
    </div>
    <div class="columna solucion">
      <div class="cabecera-columna">Con debounce 200ms · map().join("")</div>
      <div class="stats-columna" id="demo-buscador-debounce-stats-solucion">
        Filtros: 0 · último: — ms
      </div>
      <div
        id="demo-buscador-debounce-lista-solucion"
        class="lista-buscador"
        aria-label="Resultados con debounce"
      >
      </div>
    </div>
  </div>
</section>

<script>
  /* Demo interactiva del ejercicio 2 (buscador-debounce).
   * Dos modos mutuamente exclusivos ("Sin debounce" / "Con debounce")
   * seleccionables por botón. Solo el modo activo procesa el input event,
   * de modo que la experiencia de escritura refleja el coste real de esa
   * variante sin lastrarse la otra. La columna del modo inactivo se
   * oculta para dar todo el ancho a la activa. */
  type Modo = "roto" | "solucion";

  const seccion = document.getElementById("demo-buscador-debounce");
  const inputBuscador = document.getElementById(
    "demo-buscador-debounce-input",
  ) as HTMLInputElement | null;
  const cantidadSelector = document.getElementById(
    "demo-buscador-debounce-cantidad",
  ) as HTMLSelectElement | null;
  const controles = seccion?.querySelector<HTMLDivElement>(".demo-controles");
  const panelResultados = seccion?.querySelector<HTMLDivElement>(".panel-resultados");
  const modoButtons = seccion?.querySelectorAll<HTMLButtonElement>(".modo-selector button[data-modo]");
  const listaRoto = document.getElementById("demo-buscador-debounce-lista-roto");
  const listaSolucion = document.getElementById("demo-buscador-debounce-lista-solucion");
  const statsRotoEl = document.getElementById("demo-buscador-debounce-stats-roto");
  const statsSolucionEl = document.getElementById("demo-buscador-debounce-stats-solucion");

  let modoActivo: Modo = "solucion";
  let productos: string[] = [];
  let filtrosRoto = 0;
  let filtrosSolucion = 0;

  function generarProductos(cantidad: number) {
    return Array.from({ length: cantidad }, (_, i) => `Elemento ${i + 1}`);
  }

  function pintarStats(quien: Modo, ms: number) {
    const el = quien === "roto" ? statsRotoEl : statsSolucionEl;
    const veces = quien === "roto" ? filtrosRoto : filtrosSolucion;
    if (el) el.textContent = `Filtros: ${veces} · último: ${ms.toFixed(1)} ms`;
  }

  // Rota: filtra y pinta en cada evento input, con innerHTML += en el bucle.
  function filtrarRoto(query: string) {
    if (!listaRoto) return;
    filtrosRoto++;
    const t0 = performance.now();
    const q = query.toLowerCase();
    listaRoto.innerHTML = "";
    productos
      .filter((p) => p.toLowerCase().includes(q))
      .forEach((p) => {
        listaRoto.innerHTML += "<div>" + p + "</div>";
      });
    pintarStats("roto", performance.now() - t0);
  }

  // Solución: timeout fuera (vive entre llamadas) + una sola asignación con
  // map/join tras la pausa de 200ms.
  let timeoutSolucion: ReturnType<typeof setTimeout> | null = null;
  function filtrarSolucion(query: string) {
    if (timeoutSolucion) clearTimeout(timeoutSolucion);
    timeoutSolucion = setTimeout(() => {
      if (!listaSolucion) return;
      filtrosSolucion++;
      const t0 = performance.now();
      const q = query.toLowerCase().trim();
      listaSolucion.innerHTML = productos
        .filter((p) => p.toLowerCase().includes(q))
        .map((p) => `<div>${p}</div>`)
        .join("");
      pintarStats("solucion", performance.now() - t0);
    }, 200);
  }

  function setModo(nuevo: Modo) {
    if (nuevo === modoActivo) return;
    modoActivo = nuevo;
    panelResultados?.setAttribute("data-modo", nuevo);
    modoButtons?.forEach((b) => {
      const esActivo = b.dataset.modo === nuevo;
      b.classList.toggle("activo", esActivo);
      b.setAttribute("aria-selected", esActivo ? "true" : "false");
    });
    // Si hay texto en el input, re-ejecuta el handler del modo recién elegido
    // para que la columna visible refleje ya el estado con esa query.
    const q = inputBuscador?.value ?? "";
    if (q) {
      if (nuevo === "roto") filtrarRoto(q);
      else filtrarSolucion(q);
    }
  }

  function resetear() {
    const cantidad = Number(cantidadSelector?.value ?? 1000);
    productos = generarProductos(cantidad);
    filtrosRoto = 0;
    filtrosSolucion = 0;
    if (timeoutSolucion) clearTimeout(timeoutSolucion);
    pintarStats("roto", 0);
    pintarStats("solucion", 0);
    if (listaRoto) listaRoto.innerHTML = "";
    if (listaSolucion) listaSolucion.innerHTML = "";
    if (inputBuscador) inputBuscador.value = "";
  }

  if (inputBuscador && controles && cantidadSelector) {
    inputBuscador.addEventListener("input", (e) => {
      const query = (e.target as HTMLInputElement).value;
      if (modoActivo === "roto") filtrarRoto(query);
      else filtrarSolucion(query);
    });
    cantidadSelector.addEventListener("change", resetear);
    controles.addEventListener("click", (e) => {
      const target = e.target as Element;
      const modoBtn = target?.closest<HTMLButtonElement>(".modo-selector button[data-modo]");
      if (modoBtn?.dataset.modo) {
        setModo(modoBtn.dataset.modo as Modo);
        return;
      }
      const accionBtn = target?.closest<HTMLButtonElement>("button[data-accion]");
      if (accionBtn?.dataset.accion === "reset") resetear();
    });
    resetear();
  }
</script>

<style>
  .input-buscador {
    flex: 1;
    min-width: 12ch;
    font-family: var(--fuente-mono);
    font-size: var(--paso-0);
    padding: var(--esp-xs) var(--esp-sm);
    border: 1px solid var(--texto);
    border-radius: var(--radio-sm);
    background: var(--fondo);
    color: var(--texto);
  }

  .input-buscador:focus-visible {
    border-color: var(--acento);
    outline: 2px solid var(--acento);
    outline-offset: 1px;
  }

  /* Selector segmentado de modo. Override local de .demo-boton para que
     los dos botones alternen entre outlined (inactivo) y filled (activo). */
  .modo-selector {
    display: inline-flex;
    gap: var(--esp-xs);
  }

  .modo-selector .demo-boton.roto {
    background: var(--fondo);
    color: var(--error);
    border-color: var(--error);
  }

  .modo-selector .demo-boton.roto.activo {
    background: var(--error);
    color: var(--papel);
  }

  .modo-selector .demo-boton.solucion {
    background: var(--fondo);
    color: var(--acento);
    border-color: var(--acento);
  }

  .modo-selector .demo-boton.solucion.activo {
    background: var(--acento);
    color: var(--papel);
  }

  .modo-selector .demo-boton:not(.activo) {
    opacity: 0.7;
  }

  /* Panel de resultados: una sola columna visible, la del modo activo,
     ocupando todo el ancho. La otra queda display:none para no ocupar
     hueco ni pintar. */
  .panel-resultados {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--esp-lg);
  }

  .panel-resultados[data-modo="roto"] .columna.solucion,
  .panel-resultados[data-modo="solucion"] .columna.roto {
    display: none;
  }

  .columna {
    display: flex;
    flex-direction: column;
    gap: var(--esp-sm);
    padding: var(--esp-md);
    border: 2px solid var(--texto);
    border-radius: var(--radio-md);
    min-width: 0;
  }

  .columna.roto {
    border-color: var(--error);
  }

  .columna.solucion {
    border-color: var(--acento);
  }

  .cabecera-columna {
    font-family: var(--fuente-mono);
    font-size: var(--paso-000);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: var(--esp-xs);
    border-bottom: 1px solid currentColor;
  }

  .columna.roto .cabecera-columna {
    color: var(--error);
  }

  .columna.solucion .cabecera-columna {
    color: var(--acento);
  }

  .stats-columna {
    font-family: var(--fuente-mono);
    font-size: var(--paso-00);
    color: color-mix(in srgb, var(--texto) 70%, transparent);
  }

  .lista-buscador {
    max-height: 20rem;
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--texto) 20%, transparent);
    border-radius: var(--radio-sm);
    padding: var(--esp-xs);
  }

  .lista-buscador :global(div) {
    padding: var(--esp-2xs) var(--esp-xs);
    font-family: var(--fuente-mono);
    font-size: var(--paso-00);
  }
</style>
