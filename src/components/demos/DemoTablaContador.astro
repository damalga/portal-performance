---
import Nota from "../Nota.astro";
---

<section id="demo-tabla-contador" class="demo-panel" aria-labelledby="demo-tabla-contador-titulo">
  <header class="demo-titulo">
    <span class="demo-etiqueta">Pruébalo</span>
    <h3 id="demo-tabla-contador-titulo">Contador dentro del bucle vs con <code>.length</code></h3>
  </header>

  <p class="demo-intro">
    Este ejercicio suma un problema encima del anterior: el contador de
    resultados se actualiza en <em>cada</em> iteración del bucle. Como el
    navegador solo repinta el valor final, la tabla y el contador se ven
    idénticos en las dos versiones. La diferencia está en la stat
    <strong>"Updates al contador DOM"</strong> — en <em>sin optimizar</em>
    crece con cada match; en <em>optimizado</em>, uno por filtro.
  </p>

  <Nota tipo="info">
    <p>
      El navegador batch-ea los repaints, así que aunque hagas
      <code>textContent = "..."</code> cincuenta veces en un tick, solo pinta
      la última. Pero el trabajo del hilo principal (setter + invalidación de
      layout) sí se hace las cincuenta veces. Este demo lo cuenta para que se
      vea lo que la pantalla oculta.
    </p>
  </Nota>

  <div class="demo-controles" role="group" aria-label="Comparativa">
    <div class="modo-selector" role="tablist" aria-label="Elegir modo">
      <button
        type="button"
        data-modo="roto"
        class="demo-boton roto"
        role="tab"
        aria-selected="false"
      >
        Sin optimizar
      </button>
      <button
        type="button"
        data-modo="solucion"
        class="demo-boton solucion activo"
        role="tab"
        aria-selected="true"
      >
        Optimizado
      </button>
    </div>
    <input
      type="text"
      id="demo-tabla-contador-input"
      class="input-buscador"
      placeholder="Escribe para filtrar..."
      autocomplete="off"
      spellcheck="false"
    />
    <label class="demo-cantidad">
      <span>Elementos</span>
      <select id="demo-tabla-contador-cantidad">
        <option value="5">5</option>
        <option value="100">100</option>
        <option value="1000" selected>1.000</option>
      </select>
    </label>
    <button type="button" data-accion="reset" class="demo-boton reset"> Reset </button>
  </div>

  <div class="panel-resultados" data-modo="solucion">
    <div class="columna roto">
      <div class="cabecera-columna">Sin optimizar · contador dentro del bucle</div>
      <div class="stats-columna" id="demo-tabla-contador-stats-roto">
        Filtros: 0 · Updates al contador: 0 · último: — ms
      </div>
      <div class="contador-resultados" id="demo-tabla-contador-contador-roto">Resultados: 0</div>
      <div class="tabla-contenedor">
        <table class="tabla-elementos">
          <thead>
            <tr>
              <th>Elemento</th>
            </tr>
          </thead>
          <tbody id="demo-tabla-contador-tbody-roto"></tbody>
        </table>
      </div>
    </div>
    <div class="columna solucion">
      <div class="cabecera-columna">Optimizado · debounce + .length + map/join</div>
      <div class="stats-columna" id="demo-tabla-contador-stats-solucion">
        Filtros: 0 · Updates al contador: 0 · último: — ms
      </div>
      <div class="contador-resultados" id="demo-tabla-contador-contador-solucion">
        Resultados: 0
      </div>
      <div class="tabla-contenedor">
        <table class="tabla-elementos">
          <thead>
            <tr>
              <th>Elemento</th>
            </tr>
          </thead>
          <tbody id="demo-tabla-contador-tbody-solucion"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  /* Demo interactiva del ejercicio 4 (tabla-contador).
   * Dos modos mutuamente exclusivos, solo el activo procesa el input.
   * La lección específica: el contador que se actualiza dentro del bucle
   * (roto) vs una sola vez usando .length (solución). El navegador
   * repinta el mismo valor final, pero cuenta "Updates al contador DOM"
   * revela el trabajo redundante. */
  type Modo = "roto" | "solucion";

  function generarElementos(n: number): string[] {
    return Array.from({ length: n }, (_, i) => `Elemento ${i + 1}`);
  }

  const seccion = document.getElementById("demo-tabla-contador");
  const inputBuscador = document.getElementById(
    "demo-tabla-contador-input",
  ) as HTMLInputElement | null;
  const cantidadSelector = document.getElementById(
    "demo-tabla-contador-cantidad",
  ) as HTMLSelectElement | null;
  const controles = seccion?.querySelector<HTMLDivElement>(".demo-controles");
  const panelResultados = seccion?.querySelector<HTMLDivElement>(".panel-resultados");
  const modoButtons = seccion?.querySelectorAll<HTMLButtonElement>(
    ".modo-selector button[data-modo]",
  );
  const tbodyRoto = document.getElementById("demo-tabla-contador-tbody-roto");
  const tbodySolucion = document.getElementById("demo-tabla-contador-tbody-solucion");
  const contadorRoto = document.getElementById("demo-tabla-contador-contador-roto");
  const contadorSolucion = document.getElementById("demo-tabla-contador-contador-solucion");
  const statsRotoEl = document.getElementById("demo-tabla-contador-stats-roto");
  const statsSolucionEl = document.getElementById("demo-tabla-contador-stats-solucion");

  let modoActivo: Modo = "solucion";
  let elementos: string[] = [];
  let filtrosRoto = 0;
  let filtrosSolucion = 0;
  let updatesRoto = 0;
  let updatesSolucion = 0;

  function pintarStats(quien: Modo, ms: number) {
    const el = quien === "roto" ? statsRotoEl : statsSolucionEl;
    const filtros = quien === "roto" ? filtrosRoto : filtrosSolucion;
    const updates = quien === "roto" ? updatesRoto : updatesSolucion;
    if (el) el.textContent = `Filtros: ${filtros} · Updates al contador: ${updates} · último: ${ms.toFixed(1)} ms`;
  }

  // Rota (literal del ejercicio, adaptada a un elemento por fila):
  // tbody.innerHTML += en el bucle, contador actualizado en cada match.
  function filtrarRoto(query: string) {
    if (!tbodyRoto || !contadorRoto) return;
    filtrosRoto++;
    const t0 = performance.now();
    const q = query.toLowerCase();
    tbodyRoto.innerHTML = "";
    let total = 0;
    elementos.forEach((el) => {
      if (el.toLowerCase().includes(q)) {
        tbodyRoto.innerHTML += `<tr><td>${el}</td></tr>`;
        total++;
        contadorRoto.textContent = "Resultados: " + total;
        updatesRoto++;
      }
    });
    pintarStats("roto", performance.now() - t0);
  }

  // Solución (literal): debounce + filtrados.map(...).join('') + .length.
  let timeoutSolucion: ReturnType<typeof setTimeout> | null = null;
  function filtrarSolucion(query: string) {
    if (timeoutSolucion) clearTimeout(timeoutSolucion);
    timeoutSolucion = setTimeout(() => {
      if (!tbodySolucion || !contadorSolucion) return;
      filtrosSolucion++;
      const t0 = performance.now();
      const q = query.toLowerCase();
      const filtrados = elementos.filter((el) => el.toLowerCase().includes(q));
      tbodySolucion.innerHTML = filtrados.map((el) => `<tr><td>${el}</td></tr>`).join("");
      contadorSolucion.textContent = "Resultados: " + filtrados.length;
      updatesSolucion++;
      pintarStats("solucion", performance.now() - t0);
    }, 200);
  }

  function setModo(nuevo: Modo) {
    if (nuevo === modoActivo) return;
    modoActivo = nuevo;
    panelResultados?.setAttribute("data-modo", nuevo);
    modoButtons?.forEach((b) => {
      const esActivo = b.dataset.modo === nuevo;
      b.classList.toggle("activo", esActivo);
      b.setAttribute("aria-selected", esActivo ? "true" : "false");
    });
    const q = inputBuscador?.value ?? "";
    if (q) {
      if (nuevo === "roto") filtrarRoto(q);
      else filtrarSolucion(q);
    }
  }

  function resetear() {
    const cantidad = Number(cantidadSelector?.value ?? 1000);
    elementos = generarElementos(cantidad);
    filtrosRoto = 0;
    filtrosSolucion = 0;
    updatesRoto = 0;
    updatesSolucion = 0;
    if (timeoutSolucion) clearTimeout(timeoutSolucion);
    pintarStats("roto", 0);
    pintarStats("solucion", 0);
    if (tbodyRoto) tbodyRoto.innerHTML = "";
    if (tbodySolucion) tbodySolucion.innerHTML = "";
    if (contadorRoto) contadorRoto.textContent = "Resultados: 0";
    if (contadorSolucion) contadorSolucion.textContent = "Resultados: 0";
    if (inputBuscador) inputBuscador.value = "";
  }

  if (inputBuscador && controles && cantidadSelector) {
    inputBuscador.addEventListener("input", (e) => {
      const query = (e.target as HTMLInputElement).value;
      if (modoActivo === "roto") filtrarRoto(query);
      else filtrarSolucion(query);
    });
    cantidadSelector.addEventListener("change", resetear);
    controles.addEventListener("click", (e) => {
      const target = e.target as Element;
      const modoBtn = target?.closest<HTMLButtonElement>(".modo-selector button[data-modo]");
      if (modoBtn?.dataset.modo) {
        setModo(modoBtn.dataset.modo as Modo);
        return;
      }
      const accionBtn = target?.closest<HTMLButtonElement>("button[data-accion]");
      if (accionBtn?.dataset.accion === "reset") resetear();
    });
    resetear();
  }
</script>

<style>
  .input-buscador {
    flex: 1;
    min-width: 12ch;
    font-family: var(--fuente-mono);
    font-size: var(--paso-0);
    padding: var(--esp-xs) var(--esp-sm);
    border: 1px solid var(--texto);
    border-radius: var(--radio-sm);
    background: var(--fondo);
    color: var(--texto);
  }

  .input-buscador:focus-visible {
    border-color: var(--acento);
    outline: 2px solid var(--acento);
    outline-offset: 1px;
  }

  /* Selector segmentado de modo (mismo patrón que DemoBuscadorDebounce). */
  .modo-selector {
    display: inline-flex;
    gap: var(--esp-xs);
  }

  .modo-selector .demo-boton.roto {
    background: var(--fondo);
    color: var(--error);
    border-color: var(--error);
  }

  .modo-selector .demo-boton.roto.activo {
    background: var(--error);
    color: var(--papel);
  }

  .modo-selector .demo-boton.solucion {
    background: var(--fondo);
    color: var(--acento);
    border-color: var(--acento);
  }

  .modo-selector .demo-boton.solucion.activo {
    background: var(--acento);
    color: var(--papel);
  }

  .modo-selector .demo-boton:not(.activo) {
    opacity: 0.7;
  }

  /* Solo una columna visible a la vez, ocupando todo el ancho. */
  .panel-resultados {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--esp-lg);
  }

  .panel-resultados[data-modo="roto"] .columna.solucion,
  .panel-resultados[data-modo="solucion"] .columna.roto {
    display: none;
  }

  .columna {
    display: flex;
    flex-direction: column;
    gap: var(--esp-sm);
    padding: var(--esp-md);
    border: 2px solid var(--texto);
    border-radius: var(--radio-md);
    min-width: 0;
  }

  .columna.roto {
    border-color: var(--error);
  }

  .columna.solucion {
    border-color: var(--acento);
  }

  .cabecera-columna {
    font-family: var(--fuente-mono);
    font-size: var(--paso-000);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: var(--esp-xs);
    border-bottom: 1px solid currentColor;
  }

  .columna.roto .cabecera-columna {
    color: var(--error);
  }

  .columna.solucion .cabecera-columna {
    color: var(--acento);
  }

  .stats-columna {
    font-family: var(--fuente-mono);
    font-size: var(--paso-00);
    color: color-mix(in srgb, var(--texto) 70%, transparent);
  }

  .contador-resultados {
    font-family: var(--fuente-display);
    font-size: var(--paso-2);
    font-weight: 700;
    color: var(--texto);
    padding: var(--esp-xs) 0;
  }

  .tabla-contenedor {
    max-height: 20rem;
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--texto) 20%, transparent);
    border-radius: var(--radio-sm);
  }

  .tabla-elementos {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--fuente-mono);
    font-size: var(--paso-00);
  }

  .tabla-elementos th,
  .tabla-elementos td {
    padding: var(--esp-xs) var(--esp-sm);
    border-bottom: 1px solid color-mix(in srgb, var(--texto) 15%, transparent);
    text-align: left;
  }

  .tabla-elementos thead th {
    position: sticky;
    top: 0;
    background: var(--fondo);
    font-family: var(--fuente-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--paso-000);
    color: color-mix(in srgb, var(--texto) 70%, transparent);
    border-bottom: 2px solid var(--texto);
  }
</style>
